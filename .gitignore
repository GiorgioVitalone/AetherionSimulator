# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
*.tsbuildinfo

# Generated card data (build artifact)
packages/cards/data/*.json

# Deterministically-regenerable balance pools (node make-pools.mjs) -- committed
# tooling + constants reproduce these bit-for-bit; the JSON itself is not source.
packages/engine/generated-pools/

# Balance run outputs: full per-run JSONs and pre-ledger legacy artifacts are
# reproducible from the tracked ledger.jsonl (config + pool sha + runHash).
# Exception: ratification archives are lock evidence, referenced by
# sim-data/ruleset-v*.json and the lock tests — those stay tracked.
packages/engine/balance-runs/runs/*
!packages/engine/balance-runs/runs/*ratification*.json
packages/engine/balance-runs/legacy/

# Environment files
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Turbo
.turbo/

# Coverage
coverage/
